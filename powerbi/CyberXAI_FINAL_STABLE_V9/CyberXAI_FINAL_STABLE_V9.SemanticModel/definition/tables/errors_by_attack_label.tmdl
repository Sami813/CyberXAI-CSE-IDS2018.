		summarizeBy: sum
		sourceColumn: error_count

		annotation SummarizationSetBy = Automatic

	column mean_malicious_probability
		dataType: double
		formatString: 0.00%
		lineageTag: 4aff969a-ae20-4666-8742-c5f8dbdd4e35
		summarizeBy: sum
		sourceColumn: mean_malicious_probability

		annotation SummarizationSetBy = Automatic

	column mean_prediction_confidence
