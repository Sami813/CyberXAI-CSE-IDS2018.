table errors_by_attack_label
	lineageTag: 22eb2e87-54ce-4fa5-9a4b-93f71ac95a5a

	measure 'False Negative Errors' = CALCULATE(SUM(errors_by_attack_label[error_count]), errors_by_attack_label[error_type] = "False Negative")
		formatString: #,0
		lineageTag: 4d47d847-cd81-4f04-b4ce-dfffea61df13

	measure 'False Positive Errors' = CALCULATE(SUM(errors_by_attack_label[error_count]), errors_by_attack_label[error_type] = "False Positive")
		formatString: #,0
		lineageTag: 5ed2f6f6-e87f-4224-b8e3-596b7e318ea6

	measure 'Major False Negative Errors' =
			VAR v = CALCULATE(SUM(errors_by_attack_label[error_count]), errors_by_attack_label[error_type] = "False Negative")
			RETURN IF(v >= 10, v)
			formatString: #,0
		lineageTag: 7842cbcd-8842-4235-9a19-f2ff02f88588

	measure 'Major False Positive Errors' =
			VAR v = CALCULATE(SUM(errors_by_attack_label[error_count]), errors_by_attack_label[error_type] = "False Positive")
			RETURN IF(v >= 10, v)
			formatString: #,0
		lineageTag: ce61d4a3-51a3-4132-8bd2-f0f385557949

	column original_attack_label
		dataType: string
		lineageTag: 00363fac-7ebe-45b4-a0f3-4ead708f4c14
