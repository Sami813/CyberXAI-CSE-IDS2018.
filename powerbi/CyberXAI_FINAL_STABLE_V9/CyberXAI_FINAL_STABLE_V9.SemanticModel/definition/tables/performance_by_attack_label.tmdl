	partition performance_by_attack_label = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("D:\Sami Data Set\powerbi\performance_by_attack_label.csv"),[Delimiter=",", Columns=13, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"original_attack_label", type text}, {"total_records", Int64.Type}, {"actual_malicious", Int64.Type}, {"predicted_malicious", Int64.Type}, {"correct_predictions", Int64.Type}, {"true_positives", Int64.Type}, {"false_negatives", Int64.Type}, {"false_positives", Int64.Type}, {"true_negatives", Int64.Type}, {"traffic_type", type text}, {"accuracy", type number}, {"attack_detection_rate", type number}, {"benign_false_alarm_rate", type number}}),
				    #"Clean Attack Label" = Table.ReplaceValue(#"Changed Type","Infilteration","Infiltration",Replacer.ReplaceText,{"original_attack_label"})
				in
