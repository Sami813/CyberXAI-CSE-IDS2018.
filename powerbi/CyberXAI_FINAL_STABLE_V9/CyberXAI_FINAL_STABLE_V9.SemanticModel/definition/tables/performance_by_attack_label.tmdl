table performance_by_attack_label
	lineageTag: 401f2030-d037-4fcd-bafb-7325161ce07c

	measure 'Attack Detection Rate Live' = IF(SELECTEDVALUE(performance_by_attack_label[traffic_type]) = "Malicious" && MAX(performance_by_attack_label[total_records]) >= 20, MAX(performance_by_attack_label[attack_detection_rate]))
		formatString: 0.0%
		lineageTag: fd5aa864-1375-4e4d-9d73-c553fb4a99a3

	measure 'False Negatives Live' = IF(SELECTEDVALUE(performance_by_attack_label[traffic_type]) = "Malicious" && SUM(performance_by_attack_label[false_negatives]) > 0, SUM(performance_by_attack_label[false_negatives]))
		formatString: #,0
		lineageTag: e93582f3-4b27-4cb2-9420-3a35b4bfc735

