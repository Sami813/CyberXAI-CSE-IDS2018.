model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["model_summary","model_metrics","confusion_matrix","performance_by_test_file","performance_by_attack_label","feature_importance","errors_by_attack_label","errors_by_confidence_band"]

annotation PBI_ProTooling = ["DevMode"]

ref table model_summary
ref table model_metrics
ref table confusion_matrix
ref table performance_by_test_file
ref table performance_by_attack_label
ref table feature_importance
ref table errors_by_attack_label
ref table errors_by_confidence_band

ref cultureInfo en-US

